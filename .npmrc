; Yarn Berry ignores this file — it is here for the occasional direct
; npm/npx invocation. The token is a reference, never a literal (this file
; is tracked); mint one with:
;
;   export CODEARTIFACT_AUTH_TOKEN="$(aws codeartifact get-authorization-token \
;       --domain eventdex --query authorizationToken --output text)"
;
@eventdex:registry=https://eventdex-291364234808.d.codeartifact.us-east-1.amazonaws.com/npm/eventdex/
//eventdex-291364234808.d.codeartifact.us-east-1.amazonaws.com/npm/eventdex/:_authToken=${CODEARTIFACT_AUTH_TOKEN}
